# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.txt

# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Python Distribution / packaging (anchored so src/lib is NEVER ignored!)
.Python
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Explicitly ensure Next.js src/lib is tracked
!src/lib/
!src/lib/**

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Environments
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# AI Coding Assistants, Prompts & Audit Docs (Never Commit)
.agents/
.claude/
.cursor/
.gemini/
.windsurf/
CLAUDE.md
AGENTS.md
skills-lock.json
*Audit*.md
Auditing*
fix-backticks.js
build_output.txt
myself.txt
